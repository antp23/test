#!/usr/bin/env bash
#
# sandbox — Spin up a full-stack app from sandbox.yml using Docker Compose
#
# Usage:
#   ./sandbox up        Start all services (generates Docker files first)
#   ./sandbox down      Stop and remove containers (preserves volumes)
#   ./sandbox reset     Tear down everything including volumes, rebuild
#   ./sandbox logs      Tail logs for all services
#   ./sandbox logs <s>  Tail logs for a specific service
#   ./sandbox status    Show running containers and ports
#   ./sandbox shell <s> Open a shell into a running service container
#   ./sandbox generate  Generate Docker files without starting
#   ./sandbox init      Create a template sandbox.yml in the current directory
#

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SANDBOX_CONFIG:-sandbox.yml}"
OUTPUT_DIR=".sandbox"
COMPOSE_FILE="$OUTPUT_DIR/docker-compose.yml"
GENERATOR="$SCRIPT_DIR/sandbox-tools/generate.py"
TEMPLATE_DIR="$SCRIPT_DIR/sandbox-tools/templates"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No color

info()    { echo -e "${BLUE}[sandbox]${NC} $*"; }
success() { echo -e "${GREEN}[sandbox]${NC} $*"; }
warn()    { echo -e "${YELLOW}[sandbox]${NC} $*"; }
error()   { echo -e "${RED}[sandbox]${NC} $*" >&2; }

# ---------------------------------------------------------------------------
# Prerequisites check
# ---------------------------------------------------------------------------
check_prereqs() {
    local missing=0

    if ! command -v docker &>/dev/null; then
        error "Docker is not installed. Install it from https://docs.docker.com/get-docker/"
        missing=1
    fi

    if ! docker compose version &>/dev/null 2>&1; then
        error "Docker Compose V2 is not available. Update Docker or install the compose plugin."
        missing=1
    fi

    if ! command -v python3 &>/dev/null; then
        error "Python 3 is not installed. Install it from https://www.python.org/downloads/"
        missing=1
    fi

    if [ $missing -ne 0 ]; then
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Find config file
# ---------------------------------------------------------------------------
find_config() {
    if [ -f "$CONFIG_FILE" ]; then
        return 0
    fi
    # Also check for .yaml extension
    if [ -f "${CONFIG_FILE%.yml}.yaml" ]; then
        CONFIG_FILE="${CONFIG_FILE%.yml}.yaml"
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_generate() {
    if ! find_config; then
        error "No $CONFIG_FILE found in current directory."
        error "Run '$(basename "$0") init' to create one."
        exit 1
    fi

    info "Generating Docker files from ${BOLD}$CONFIG_FILE${NC}..."
    python3 "$GENERATOR" "$CONFIG_FILE" "$OUTPUT_DIR" "$(pwd)"
    success "Files generated in ${BOLD}$OUTPUT_DIR/${NC}"
}

cmd_up() {
    check_prereqs

    cmd_generate

    info "Starting services..."
    docker compose -f "$COMPOSE_FILE" up --build -d

    echo ""
    success "Services are starting up!"
    echo ""

    # Parse config to show access URLs
    _show_urls
}

cmd_down() {
    if [ ! -f "$COMPOSE_FILE" ]; then
        error "No $COMPOSE_FILE found. Run '$(basename "$0") up' first."
        exit 1
    fi

    info "Stopping services..."
    docker compose -f "$COMPOSE_FILE" down
    success "All services stopped."
}

cmd_reset() {
    if [ -f "$COMPOSE_FILE" ]; then
        info "Tearing down services and volumes..."
        docker compose -f "$COMPOSE_FILE" down -v --remove-orphans
    fi

    if [ -d "$OUTPUT_DIR" ]; then
        info "Removing generated files..."
        rm -rf "$OUTPUT_DIR"
    fi

    success "Reset complete. Run '$(basename "$0") up' to start fresh."
}

cmd_logs() {
    if [ ! -f "$COMPOSE_FILE" ]; then
        error "No $COMPOSE_FILE found. Run '$(basename "$0") up' first."
        exit 1
    fi

    local service="${1:-}"
    if [ -n "$service" ]; then
        docker compose -f "$COMPOSE_FILE" logs -f "$service"
    else
        docker compose -f "$COMPOSE_FILE" logs -f
    fi
}

cmd_status() {
    if [ ! -f "$COMPOSE_FILE" ]; then
        error "No $COMPOSE_FILE found. Run '$(basename "$0") up' first."
        exit 1
    fi

    docker compose -f "$COMPOSE_FILE" ps
}

cmd_shell() {
    local service="${1:-}"
    if [ -z "$service" ]; then
        error "Usage: $(basename "$0") shell <service>"
        exit 1
    fi

    if [ ! -f "$COMPOSE_FILE" ]; then
        error "No $COMPOSE_FILE found. Run '$(basename "$0") up' first."
        exit 1
    fi

    info "Opening shell in ${BOLD}$service${NC}..."
    docker compose -f "$COMPOSE_FILE" exec "$service" sh
}

cmd_init() {
    if [ -f "$CONFIG_FILE" ]; then
        warn "$CONFIG_FILE already exists. Remove it first to regenerate."
        exit 1
    fi

    local template="$TEMPLATE_DIR/sandbox.yml.template"
    if [ -f "$template" ]; then
        cp "$template" "$CONFIG_FILE"
    else
        # Fallback inline template
        cat > "$CONFIG_FILE" << 'TEMPLATE'
# Sandbox Environment Configuration
# Edit this file to match your project, then run: ./sandbox up

name: my-project

services:
  # Example: PostgreSQL database
  database:
    image: postgres:15-alpine
    port: 5432
    environment:
      POSTGRES_USER: myapp
      POSTGRES_PASSWORD: myapp
      POSTGRES_DB: myapp_dev
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: pg_isready -U myapp
      interval: 5s
      retries: 5

  # Example: Node.js backend
  backend:
    runtime: node
    path: ./backend
    port: 3001
    node_version: "22"
    install: npm install
    build: npm run build
    start: npm start
    environment:
      DATABASE_URL: postgresql://myapp:myapp@database:5432/myapp_dev
      PORT: "3001"
      NODE_ENV: development
    depends_on:
      database: healthy
    init:
      - npx prisma migrate deploy
      - npx prisma db seed

  # Example: React frontend
  frontend:
    runtime: node
    path: ./frontend
    port: 5173
    node_version: "22"
    install: npm install
    build: npm run build
    start: npx serve dist -l 5173
    depends_on:
      backend: started

volumes:
  db_data:
TEMPLATE
    fi

    success "Created ${BOLD}$CONFIG_FILE${NC}"
    info "Edit it to match your project, then run: ${BOLD}./sandbox up${NC}"
}

# ---------------------------------------------------------------------------
# Helper: show access URLs after startup
# ---------------------------------------------------------------------------
_show_urls() {
    # Quick Python one-liner to extract service ports from config
    python3 -c "
import sys
sys.path.insert(0, '$(dirname "$GENERATOR")')
from generate import load_config
config = load_config('$CONFIG_FILE')
services = config.get('services', {})
print('  Access your services at:')
print()
for name, svc in services.items():
    if isinstance(svc, str):
        continue
    port = svc.get('port')
    if port and not svc.get('image', '').startswith(('postgres', 'mysql', 'mongo', 'redis', 'memcache')):
        print(f'    {name:20s} http://localhost:{port}')
    elif port:
        print(f'    {name:20s} localhost:{port}')
print()
" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
cmd_help() {
    echo ""
    echo -e "  ${BOLD}sandbox${NC} — Spin up a full-stack app for testing and demos"
    echo ""
    echo -e "  ${CYAN}Usage:${NC}"
    echo "    ./sandbox <command> [options]"
    echo ""
    echo -e "  ${CYAN}Commands:${NC}"
    echo "    up              Build and start all services"
    echo "    down            Stop all services (preserves data)"
    echo "    reset           Stop services, remove volumes, clean generated files"
    echo "    logs [service]  Tail service logs (all or specific)"
    echo "    status          Show running containers and ports"
    echo "    shell <service> Open a shell into a running container"
    echo "    generate        Generate Docker files without starting"
    echo "    init            Create a template sandbox.yml"
    echo "    help            Show this help message"
    echo ""
    echo -e "  ${CYAN}Configuration:${NC}"
    echo "    Place a sandbox.yml in your project root."
    echo "    Set SANDBOX_CONFIG env var to use a different filename."
    echo ""
    echo -e "  ${CYAN}Examples:${NC}"
    echo "    ./sandbox up              # Start everything"
    echo "    ./sandbox logs backend    # Follow backend logs"
    echo "    ./sandbox shell database  # Connect to database container"
    echo "    ./sandbox reset           # Fresh start"
    echo ""
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        up)       cmd_up "$@" ;;
        down)     cmd_down "$@" ;;
        reset)    cmd_reset "$@" ;;
        logs)     cmd_logs "$@" ;;
        status|ps) cmd_status "$@" ;;
        shell)    cmd_shell "$@" ;;
        generate) cmd_generate "$@" ;;
        init)     cmd_init "$@" ;;
        help|-h|--help) cmd_help ;;
        *)
            error "Unknown command: $command"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
