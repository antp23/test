# Sandbox Environment Configuration
# Edit this file to match your project, then run: ./sandbox up
#
# Docs: https://github.com/your-org/sandbox#configuration
#
# Supported runtimes: node, python, static
# Services with 'image' use a Docker image directly (databases, caches, etc.)
# Services with 'runtime' get a generated Dockerfile.

name: my-project

services:
  # --- Database ---
  # Use any Docker image for infrastructure services
  database:
    image: postgres:15-alpine
    port: 5432
    environment:
      POSTGRES_USER: myapp
      POSTGRES_PASSWORD: myapp
      POSTGRES_DB: myapp_dev
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: pg_isready -U myapp
      interval: 5s
      retries: 5

  # --- Backend API ---
  # 'runtime: node' generates a Node.js Dockerfile
  backend:
    runtime: node
    path: ./backend
    port: 3001
    node_version: "22"
    install: npm install
    build: npm run build
    start: npm start
    environment:
      DATABASE_URL: postgresql://myapp:myapp@database:5432/myapp_dev
      PORT: "3001"
      NODE_ENV: development
    depends_on:
      database: healthy
    # init commands run once on first startup (migrations, seeds, etc.)
    init:
      - npx prisma migrate deploy
      - npx prisma db seed

  # --- Frontend ---
  frontend:
    runtime: node
    path: ./frontend
    port: 5173
    node_version: "22"
    install: npm install
    build: npm run build
    start: npx serve dist -l 5173
    depends_on:
      backend: started

  # --- Uncomment for Redis cache ---
  # cache:
  #   image: redis:7-alpine
  #   port: 6379

volumes:
  db_data:
