# =============================================================================
# Safeway Lead Gen - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/safeway_lead_gen

# --- Apollo.io API ---
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_RATE_LIMIT_PER_MIN=100

# --- Google Places API ---
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_api_key_here
GOOGLE_RATE_LIMIT_PER_MIN=500

# --- Notion API ---
# Create an integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token_here
NOTION_PROSPECTS_DB_ID=your_prospects_database_id
NOTION_VENDORS_DB_ID=your_vendors_database_id

# --- Slack ---
# Create a webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#lead-gen-alerts

# --- FDA ---
# Optional API key for higher rate limits: https://open.fda.gov/apis/authentication/
FDA_API_KEY=

# --- Scraper Settings ---
SCRAPER_USER_AGENT=SafewayDistributors/1.0
SCRAPER_REQUEST_DELAY=2.0
SCRAPER_MAX_RETRIES=3

# --- Enrichment Settings ---
ENRICHMENT_BATCH_SIZE=50

# --- Rep Assignment ---
REPS=Colin,Kevin
DEFAULT_REP=Colin

# --- State Tiers ---
TIER_1_STATES=FL,TX,CA,NY,NJ,PA,OH,GA,NC,AZ
TIER_2_STATES=IL,MI,VA,MA,TN,MO,WI,MN,MD,IN

# --- Logging ---
LOG_LEVEL=INFO
